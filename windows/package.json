{
  "name": "yurec-xuec",
  "productName": "Yurec",
  "version": "1.65.4",
  "description": "Жизнь Юрца",
  "author": "Konstantin Smirnov",
  "homepage": "https://nickstokes215.github.io/yurec_xuec/",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64",
    "pack:linux": "electron-builder --linux deb --x64"
  },
  "devDependencies": {
    "electron": "32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.yurec.xuec",
    "productName": "Yurec",
    "copyright": "Konstantin Smirnov",
    "artifactName": "yurec_xuec.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "www/**/*", "icon.png"],
    "asar": true,
    "win": {
      "icon": "icon.png",
      "executableName": "yurec_xuec",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "yurec_xuec.exe"
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "executableName": "yurec_xuec",
      "maintainer": "Konstantin Smirnov",
      "target": [{ "target": "deb", "arch": ["x64"] }],
      "desktop": {
        "Name": "Жизнь Юрца",
        "Comment": "Сборник Жизнь Юрца",
        "Categories": "AudioVideo;Game;"
      }
    },
    "deb": {
      "packageName": "yurec-xuec",
      "artifactName": "yurec_xuec.deb"
    }
  }
}
